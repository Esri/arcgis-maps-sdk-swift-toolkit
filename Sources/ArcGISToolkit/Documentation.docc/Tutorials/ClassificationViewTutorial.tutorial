@Tutorial(time: 5) {
    @Intro(title: "ClassificationView Tutorial") {
        This tutorial shows you how to frame a map with the classification marking
        from its portal item.
        @Image(
            source: ClassificationView,
            alt: "A web map framed by classification bars at the top and bottom."
        )
    }

    @Section(title: "Display a portal item's classification") {
        @ContentAndMedia {
            Before starting, configure your app to handle authentication challenges
            by following the <doc:AuthenticatorTutorial>. You also need the URL of
            a portal and the ID of a classified web map in that portal.

            This example selects an authenticated connection in the app. The
            component preserves the supplied portal and its connection mode.

            @Image(
                source: ClassificationView,
                alt: "A web map framed by classification bars at the top and bottom."
            )
        }

        @Steps {
            @Step {
                Create a map from a classified portal item and display it in a
                `MapView`. Replace the placeholders with your portal URL and portal
                item ID.

                @Code(
                    name: "ClassificationViewExample.swift",
                    file: ClassificationViewStep1.swift
                )
            }

            @Step {
                Apply the `classification(portalItem:)` modifier using the map's
                portal item.

                The component loads the supplied item's portal first, then reuses
                available classification or loads a fresh item through the same
                portal to obtain classification metadata.

                The map remains hidden behind a loading indicator until
                classification loading succeeds. It then appears with the
                classification bars, or without bars if no classification was
                returned. A loading failure displays an error with a Retry action
                instead of the map.

                @Code(
                    name: "ClassificationViewExample.swift",
                    file: ClassificationViewStep2.swift
                )
            }
        }
    }
}
