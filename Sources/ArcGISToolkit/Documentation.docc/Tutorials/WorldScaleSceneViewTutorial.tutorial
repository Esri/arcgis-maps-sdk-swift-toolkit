@Tutorial(time: 10) {
    @Intro(title: "WorldScaleSceneView Tutorial") {
        `WorldScaleSceneView` provides an augmented reality world-scale experience.
        @Image(source: WorldScaleSceneView, alt: "An image of a world scale AR experience.")
    }
    
    @Section(title: "Using the WorldScaleSceneView") {
        @ContentAndMedia {
            @Image(source: WorldScaleSceneView, alt: "An image of a world-scale AR experience.")
        }
        
        @Steps {
            @Step {
                Initialize a `WorldScaleSceneView` which requires a world-tracking
                `provider` and closures for the `cameraFeedView` and `sceneView`.
                @Code(name: "WorldScaleExampleView.swift", file: WorldScaleSceneViewStep1.swift)
            }
            
            @Step {
                Specify the `provider` for the `WorldScaleSceneView`. The provider is responsible for providing the world tracking data to the `WorldScaleSceneView`. In this example, we use the `AppleWorldTracking` provider which utilizes ARKit's world tracking capabilities. For the `AppleWorldTracking.Mode` we specify `.worldTracking` to use Apple's `ARWorldTrackingConfiguration`.
                
                See the `CustomVPSProviderExample` project for an example of how to implement a custom VPS provider that conforms to the `WorldTrackingProvider` protocol.
                @Code(name: "WorldScaleExampleView.swift", file: WorldScaleSceneViewStep2.swift)
            }
            
            @Step {
                Add a `View` that displays the camera feed to the `cameraFeedView` closure. The closure builds and displays the camera feed for the augmented reality experience. In this example, we use the `AppleWorldTrackingCameraFeedView` and specify the session provider `context`. The `AppleWorldTrackingCameraFeedView` also has view modifers to observe the status of the AR session including `onCameraTrackingStateChanged(perform:)` and `onGeoTrackingStatusChanged(perform:)`.
                
                If you are implementing a custom provider, you will also need to implement a custom camera feed view that uses the session provider `context`. See the `CustomVPSProviderExample` project for an example of how to implement a custom camera feed view.
                @Code(name: "WorldScaleExampleView.swift", file: WorldScaleSceneViewStep3.swift)
            }
            
            @Step {
                Add a `SceneView` to the `WorldScaleSceneView` closure. The closure builds and overlays 
                the scene view on top of the augmented reality video feed. Specify the `scene` state 
                variable.
                @Code(name: "WorldScaleExampleView.swift", file: WorldScaleSceneViewStep4.swift)
            }
            
            @Step {
                Set the `scene.baseSurface.opacity` to zero to make the basemap transparent.
                @Code(name: "WorldScaleExampleView.swift", file: WorldScaleSceneViewStep5.swift)
            }
            
            @Step {
                Request when-in-use location authorization to access the current location.
                
                This is necessary because we use a location datasource to get the initial location 
                in order to display a ring around the initial location. The current location is also
                necessary because the `WorldScaleSceneView` utilizes a location datasource that
                will not start until authorized.
                @Code(name: "WorldScaleExampleView.swift", file: WorldScaleSceneViewStep6.swift)
            }
            
            @Step {
                Start the provider location datasource and get the initial location.
                @Code(name: "WorldScaleExampleView.swift", file: WorldScaleSceneViewStep7.swift)
            }
            
            @Step {
                To display a ring around the initial location, create a graphic using the 
                initial location and add it to the graphics overlay.
                @Code(name: "WorldScaleExampleView.swift", file: WorldScaleSceneViewStep8.swift)
            }
        }
    }
}
